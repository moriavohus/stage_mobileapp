<% date = local_assigns.fetch(:date) { "Пятница, 25 сентября" }; title = local_assigns.fetch(:title) { "Сегодня для себя" }
   items = local_assigns.fetch(:items) { [{ title: "Дыхание 4-7-8", time: "22:00 – 22:10", duration: "10 мин", domain: "sleep" }, { title: "Тихая прогулка", time: "18:00 – 18:30", duration: "30 мин", domain: "mind" }] } %>
<section class="widget w-today">
  <p class="w-today__date text-body-l"><%= date %></p>
  <div class="w-today__sheet">
    <h3 class="w-today__title text-title-section"><%= title %></h3>
    <div class="w-today__divider"></div>
    <div class="w-today__items">
      <% items.each do |it| %>
        <div class="w-today__item">
          <span class="w-today__thumb"><%= domain_icon(it[:domain], size: 20) %></span>
          <span class="w-today__text"><span class="w-today__item-title text-body-l"><%= it[:title] %></span><span class="w-today__time text-body-l"><%= it[:time] %></span></span>
          <span><span class="widget-badge text-body-l"><%= icon "clock" %><%= it[:duration] %></span></span>
        </div>
      <% end %>
    </div>
  </div>
</section>
