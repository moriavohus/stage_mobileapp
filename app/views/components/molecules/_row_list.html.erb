<% title = local_assigns.fetch(:title) { "Почему мышцы важны уже в 30" }; subtitle = local_assigns.fetch(:subtitle) { "3 минуты" }; domain = local_assigns.fetch(:domain) { "strength" }; href = local_assigns.fetch(:href) { nil } %>
<%= content_tag(href ? :a : :div, href: href, class: "row-list") do %>
  <span class="ios-row">
    <span class="ios-row__avatar"><%= atom "avatar", domain:, tone: "lavender", variant: "small", size: 46 %></span>
    <span class="ios-row__content">
      <span class="ios-row__text">
        <span class="ios-row__title text-ios-body"><%= title %></span>
        <% if subtitle.present? %><span class="ios-row__subtitle text-ios-subheadline"><%= subtitle %></span><% end %>
      </span>
      <%= render "components/molecules/ios_row_trailing" %>
    </span>
  </span>
<% end %>
